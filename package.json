{
  "name": "dsh-wisp-science-lab",
  "version": "0.1.0",
  "type": "module",
  "description": "Laboratory PI for DeepSeek Harness: read-only progress snapshots of local Wisp Science projects / 实验室 PI：只读查看本机 Wisp Science 课题进展",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wisp",
    "wisp-science"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuzhougeng/dsh-wisp-science-lab.git"
  },
  "bugs": {
    "url": "https://github.com/xuzhougeng/dsh-wisp-science-lab/issues"
  },
  "homepage": "https://github.com/xuzhougeng/dsh-wisp-science-lab#readme",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=lib/index.js",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/paths.test.ts tests/store.test.ts",
    "print-snapshot": "node --experimental-strip-types scripts/print-snapshot.ts",
    "build-mini": "node --experimental-strip-types scripts/build-mini-sqlite.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  }
}
